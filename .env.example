# 4000 matches the mobile client's EXPO_PUBLIC_API_BASE_URL default (http://<host>:4000/v1)
PORT=4000
NODE_ENV=development

# Behind a reverse proxy (Nginx on the same host) set TRUST_PROXY=1, so rate limiting
# sees real client IPs. CORS_ORIGINS is a comma-separated allowlist; unset allows any.
TRUST_PROXY=
CORS_ORIGINS=

DB_HOST=localhost
DB_PORT=5434
DB_NAME=ecotrack
# Runtime role (NOBYPASSRLS). `pnpm db:migrate` sets this role's password from
# DB_PASSWORD, so use a real secret anywhere but local Docker.
DB_USER=ecotrack_app
DB_PASSWORD=ecotrack_app
DB_MIGRATOR_USER=ecotrack
DB_MIGRATOR_PASSWORD=ecotrack
# TLS: disable (local Docker) | require | verify-full. For RDS use verify-full with
# DB_SSL_CA pointing at the downloaded global-bundle.pem.
DB_SSL=disable
DB_SSL_CA=

# WSO2 Asgardeo. Defaults below target the local mock (`pnpm mock:jwks`), which exists
# so the API can be exercised before the real tenant is configured.
#
# For the real tenant, use:
#   OIDC_JWKS_URI=https://api.asgardeo.io/t/<org>/oauth2/jwks
#   OIDC_ISSUER=https://api.asgardeo.io/t/<org>/oauth2/token   (required in production)
#   OIDC_AUDIENCE=<web app client ID>,<mobile app client ID>
#
# Two Asgardeo settings bite if missed (see README):
#   1. Access tokens default to OPAQUE — switch both applications to JWT.
#   2. `email` must be added under Access Token Attributes, which is a different
#      field from the User Attributes tab.
OIDC_JWKS_URI=http://localhost:9999/jwks
OIDC_ISSUER=
OIDC_AUDIENCE=

# Object storage. These defaults target the local MinIO service in docker-compose.
# For real S3 on EC2: set S3_BUCKET and S3_REGION only. Delete the other S3_* lines
# (the instance profile role supplies credentials; empty values fail validation).
S3_BUCKET=ecotrack-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ecotrack
S3_SECRET_ACCESS_KEY=ecotrack123
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/ecotrack-media

# Expo push. Only needed once "Enhanced push security" is enabled on the Expo project.
EXPO_ACCESS_TOKEN=
